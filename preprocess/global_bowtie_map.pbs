#!/bin/bash
#PBS -S /bin/bash
#PBS -q mediumq
#PBS -l select=1:ncpus=20:mem=120gb
#PBS -l walltime=72:00:00
#PBS -P bric
#PBS -N bowtie2_mapping_global
#PBS -o logs/map.%J.out
#PBS -e logs/map.%J.err
#PBS -J 1-27%5

cd $PBS_O_WORKDIR
mkdir -p logs

module load anaconda3/2022.05
source activate bowtie_env
module load samtools/1.18

echo "bowtie2: $(which bowtie2)"
echo "samtools: $(which samtools)"

# ======================
# PATHS
# ======================
BASE_DIR="."

READS_DIR="${BASE_DIR}/old_kneaddata"
OUT_DIR="${BASE_DIR}/bowtie2_mapping_global"

# 👉 SINGLE GLOBAL INDEX (IMPORTANT CHANGE)
INDEX="${BASE_DIR}/bowtie2_index_global/global_index"

mkdir -p "$OUT_DIR"

# ======================
# SAMPLES
# ======================
SAMPLES=(
L1-1 L1-2 L1-3 L1-4 L1-5 L1-6 L1-7 L1-8 L1-9
L3-10 L3-11 L3-12 L3-13 L3-14 L3-15 L3-16 L3-17 L3-18
L5-19 L5-20 L5-21 L5-22 L5-23 L5-24 L5-25 L5-26 L5-27
)

sample=${SAMPLES[$((PBS_ARRAY_INDEX-1))]}
echo "Processing sample: $sample"

BAM_OUT="${OUT_DIR}/${sample}.sorted.bam"

# ======================
# SKIP IF DONE
# ======================
if [ -f "$BAM_OUT" ]; then
    echo "Already done: $sample"
    exit 0
fi

# ======================
# VERIFY INDEX
# ======================
if [ ! -f "${INDEX}.1.bt2" ]; then
    echo "ERROR: Global index not found at $INDEX"
    exit 1
fi

# ======================
# READS
# ======================
R1="${READS_DIR}/${sample}_knead/${sample}_R1_paired_kneaddata_paired_1.fastq"
R2="${READS_DIR}/${sample}_knead/${sample}_R1_paired_kneaddata_paired_2.fastq"

if [ ! -f "$R1" ]; then
    R1=$(ls ${READS_DIR}/${sample}_knead/*paired_1.fastq 2>/dev/null | head -1)
    R2=$(ls ${READS_DIR}/${sample}_knead/*paired_2.fastq 2>/dev/null | head -1)
fi

if [ -z "$R1" ] || [ ! -f "$R1" ]; then
    echo "ERROR: Reads not found for $sample"
    exit 1
fi

echo "R1: $R1"
echo "R2: $R2"

# ======================
# MAPPING
# ======================
echo "Mapping $sample..."

bowtie2 \
    -x "$INDEX" \
    -1 "$R1" \
    -2 "$R2" \
    --threads 20 \
    --very-sensitive \
    --no-unal \
    -q \
    2> "${OUT_DIR}/${sample}.log" \
| samtools sort -@ 20 -o "$BAM_OUT"

# ======================
# CHECK
# ======================
if [ $? -ne 0 ]; then
    echo "ERROR: Mapping failed for $sample"
    exit 1
fi

# ======================
# BAM INDEX
# ======================
samtools index "$BAM_OUT"

# ======================
# STATS
# ======================
samtools flagstat "$BAM_OUT" > "${OUT_DIR}/${sample}.flagstat.txt"

echo "Finished: $sample"
echo "BAM: $BAM_OUT"	
