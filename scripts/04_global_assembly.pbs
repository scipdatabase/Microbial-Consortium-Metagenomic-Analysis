#!/bin/bash
#PBS -S /bin/bash
#PBS -q mediumq
#PBS -l select=1:ncpus=20:mem=64gb
#PBS -l walltime=48:00:00
#PBS -P bric
#PBS -N megahit_coassembly
#PBS -o logs/megahit.out
#PBS -e logs/megahit.err
cd $PBS_O_WORKDIR
mkdir -p logs
#=========================
# 1. ENV
#=========================
module load anaconda3/2022.05
source activate megahit_env
megahit --version

#=========================
# 2. PATHS
#=========================
BASE_DIR="."
READ_DIR="${BASE_DIR}/old_kneaddata"
OUT_DIR="${BASE_DIR}/megahit_coassembly_2"
LOG_FILE="${BASE_DIR}/logs/megahit_run.log"   

#=========================
# 3. COLLECT READS (YOUR FORMAT)
#=========================
echo "Finding paired reads..."
R1_FILES=$(find $READ_DIR -name "*_paired_1.fastq" | sort | tr '\n' ',' | sed 's/,$//')
R2_FILES=$(find $READ_DIR -name "*_paired_2.fastq" | sort | tr '\n' ',' | sed 's/,$//')
echo "R1 files:"
echo $R1_FILES | tr ',' '\n'
echo "R2 files:"
echo $R2_FILES | tr ',' '\n'
#=========================
# 4. SAFETY CHECK (IMPORTANT)
#=========================
R1_COUNT=$(echo $R1_FILES | tr ',' '\n' | wc -l)
R2_COUNT=$(echo $R2_FILES | tr ',' '\n' | wc -l)
echo "R1 count: $R1_COUNT"
echo "R2 count: $R2_COUNT"
if [ "$R1_COUNT" -ne "$R2_COUNT" ]; then
    echo "ERROR: R1 and R2 counts do not match!"
    exit 1
fi

#=========================
# 5. MEGAHIT CO-ASSEMBLY
#=========================
echo "Starting MEGAHIT co-assembly..."
pwd
echo "TMPDIR: $TMPDIR"
ls -ld $TMPDIR 2>/dev/null

rm -rf "$OUT_DIR"   # clean slate

megahit \
    -1 "$R1_FILES" \
    -2 "$R2_FILES" \
    --presets meta-sensitive \
    -t 20 \
    -m 0.9 \
    --min-contig-len 1000 \
    -o "$OUT_DIR" \
    2> "$LOG_FILE"     # <-- log goes to pre-existing logs/ dir

#=========================
# 6. CHECK OUTPUT
#=========================
if [ $? -ne 0 ]; then
    echo "MEGAHIT FAILED — log below:"
    cat "$LOG_FILE"    # <-- same path
    exit 1
fi

